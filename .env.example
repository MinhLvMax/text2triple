# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO TEXT2TRIPLE
# ==============================================================================

# 1. Cấu hình LLM Providers
# OpenAI API Key (sử dụng GPT-4o, GPT-4o-mini, ...)
OPENAI_API_KEY=

# Groq API Key (sử dụng LLaMA, Mixtral tốc độ cao)
GROQ_API_KEY=

# Google AI Studio API Key (sử dụng Gemini 2.5 Flash, Gemini 1.5 Pro, ...)
GOOGLE_API_KEY=

# Ollama (dành cho mô hình Local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_API_KEY=

# 2. Cấu hình Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
